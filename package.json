{
  "name": "move-prop-types",
  "version": "0.0.0-development",
  "description": "CLI that converts React.PropTypes usage to the standalone prop-types package",
  "main": "build/mpt.js",
  "type": "module",
  "keywords": [
    "react",
    "prop-types",
    "proptypes",
    "react-15",
    "codemod",
    "migration",
    "cli",
    "mpt"
  ],
  "bin": {
    "move-prop-types": "build/mpt.js",
    "mpt": "build/mpt.js"
  },
  "files": [
    "build/mpt.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "build": "tsc && rollup -c",
    "postbuild": "node build/updateFile.js build/mpt.js",
    "watch": "tsc --watch",
    "lint": "eslint src --ext .ts --fix",
    "lint:check": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf *.log build coverage dist",
    "prepare": "husky",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test:ci && pnpm run lint:check"
  },
  "author": "Visweshwaran S",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@eslint/js": "^9.28.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.10.2",
    "@types/prop-types": "^15.7.15",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.28.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.9.9",
    "prop-types": "^15.8.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "semantic-release": "^25.0.9",
    "typescript": "^5.8.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vish288/move-prop-types.git"
  },
  "homepage": "https://github.com/vish288/move-prop-types#readme",
  "bugs": {
    "url": "https://github.com/vish288/move-prop-types/issues"
  }
}
